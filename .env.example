# 배포본이 학생 기록을 저장할 곳 — 시트에 붙인 Apps Script 웹 앱(scripts/sheets-api.gs).
# 교실에서 `npm run dev`로 쓸 때는 비워 두면 되고, 그러면 data/store.json에 저장된다.
SHEETS_API_URL=https://script.google.com/macros/s/xxxxxxxx/exec
SHEETS_API_TOKEN=

# 저장소 못 박기: local(파일) | sheets(구글 시트)
# 비워 두면 위 두 값이 모두 있을 때 sheets, 아니면 local로 동작한다.
DATA_BACKEND=
